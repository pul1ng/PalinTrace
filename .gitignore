# Dependencies
.venv/
*.egg-info/
dist/
build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example
# Only the LLM template is versioned under config/.
/config/*
!/config/llm/
/config/llm/*
!/config/llm/llm.example.toml
!/config/llm/preprocess_llm.toml.example
/config/llm/preprocess_llm.toml
llm.local.toml

# Local data: dataset exports, image archives, recorded trajectories
data/

# Generated deliverables
/outputs/

# Local validation reports and evidence
/docs/validation/

# Snapshot optimization experiment outputs
/docs/dev/*

# macOS metadata in any directory
.DS_Store
